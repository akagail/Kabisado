# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Session and auth (KAB-101)
FRONTEND_URL=http://localhost:3000
SESSION_INACTIVITY_SECONDS=1800
ENABLE_BREACHED_PASSWORD_CHECK=false
PASSWORD_RESET_TIMEOUT=259200

# Leave empty to use SQLite locally.
DATABASE_URL=postgres://kabisado:kabisado@localhost:5432/kabisado

